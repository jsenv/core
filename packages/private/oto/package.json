{
  "name": "oto",
  "version": "0.0.4",
  "type": "module",
  "private": true,
  "workspaces": [
    "./packages/*"
  ],
  "exports": {
    "./*": "./*"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:serve": "node ./scripts/build_serve.mjs --open",
    "dev": "node ./scripts/dev.mjs",
    "eslint": "npx eslint .",
    "playwright:install": "npx playwright install-deps && npx playwright install",
    "prettier": "prettier --write .",
    "start": "npm run dev -- --open",
    "test": "node ./scripts/test.mjs",
    "test:coverage": "npm run test -- --coverage"
  },
  "dependencies": {
    "@jsenv/dom": "../../frontend/dom",
    "@jsenv/navi": "../../frontend/navi",
    "@preact/signals": "2.11.4",
    "hooks": "./packages/hooks",
    "matrix": "./packages/matrix",
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "8.0.1",
    "@jsenv/assert": "../../tooling/assert",
    "@jsenv/core": "../../../",
    "@jsenv/custom-elements-redefine": "../../frontend/custom-elements-redefine",
    "@jsenv/eslint-config-relax": "../../tooling/eslint-config-relax",
    "@jsenv/plugin-preact": "../../related/plugin-preact",
    "@jsenv/test": "../../related/test",
    "@playwright/browser-chromium": "1.64.1",
    "eslint": "10.9.1",
    "open": "11.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0"
  },
  "volta": {
    "node": "22.18.0"
  }
}
