{
  "name": "jsenv-template-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run dev -- --open",
    "dev": "node --watch ./scripts/dev.mjs",
    "test": "node ./scripts/test.mjs",
    "test:coverage": "npm run test -- --coverage",
    "build": "node ./scripts/build.mjs",
    "build:serve": "node ./scripts/build_serve.mjs --open",
    "eslint": "npx eslint .",
    "prettier": "prettier --write ."
  },
  "devDependencies": {
    "@jsenv/assert": "4.5.7",
    "@jsenv/core": "41.5.17",
    "@jsenv/eslint-config-relax": "2.0.4",
    "@jsenv/plugin-bundling": "2.10.28",
    "@jsenv/plugin-minification": "1.7.21",
    "@jsenv/test": "3.7.46",
    "eslint": "10.9.1",
    "open": "11.0.1",
    "@playwright/browser-chromium": "1.62.1",
    "prettier": "3.9.6",
    "playwright": "1.62.1"
  }
}
