{
  "name": "@jsenv/js-module-fallback",
  "version": "1.6.7",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsenv/core",
    "directory": "packages/internal/js-module-fallback"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "main": "./src/main.js",
  "exports": {
    ".": {
      "import": {
        "dev:jsenv": "./src/main.js",
        "default": "./dist/jsenv_js_module_fallback.js"
      }
    },
    "./*": "./*"
  },
  "files": [
    "/dist/",
    "/src/"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "eslint": "npx eslint . --ext=.js,.mjs,.cjs,.html",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@babel/plugin-transform-dynamic-import": "8.0.1",
    "@babel/plugin-transform-modules-systemjs": "8.0.1",
    "@babel/plugin-transform-modules-umd": "8.0.1",
    "@jsenv/ast": "6.10.3",
    "@jsenv/sourcemap": "1.4.8",
    "@jsenv/urls": "2.9.12"
  },
  "devDependencies": {
    "@jsenv/core": "../../../",
    "@jsenv/plugin-as-js-classic": "../../related/plugin-as-js-classic"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./src/clent/s.js"
  ]
}
