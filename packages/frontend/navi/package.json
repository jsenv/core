{
  "name": "@jsenv/navi",
  "version": "0.29.126",
  "type": "module",
  "description": "Library of components including navigation to create frontend applications",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsenv/core",
    "directory": "packages/frontend/navi"
  },
  "author": {
    "name": "dmail",
    "email": "dmaillard06@gmail.com"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "dev:jsenv": "./index.js",
      "default": "./dist/jsenv_navi.js"
    },
    "./*": "./*"
  },
  "files": [
    "/dist/",
    "/docs/"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@jsenv/dom": "0.17.32",
    "@jsenv/humanize": "1.7.8",
    "@jsenv/validity": "0.4.3"
  },
  "devDependencies": {
    "@jsenv/assert": "4.5.7",
    "@jsenv/core": "../../../",
    "@jsenv/filesystem": "../../tooling/filesystem",
    "@jsenv/plugin-preact": "../../related/plugin-preact",
    "@jsenv/snapshot": "../../tooling/snapshot",
    "@jsenv/terminal-table": "../../tooling/terminal-table",
    "@jsenv/urls": "../../tooling/urls",
    "@preact/signals": "2.11.1",
    "playwright": "1.62.1",
    "preact": "11.0.0-beta.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./src/navi_css_vars.js",
    "./src/navi_z_indexes.js",
    "./src/control/interaction/*.js",
    "./dist/jsenv_navi_side_effects.js",
    "./dist/jsenv_navi.js"
  ]
}
