{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // resolve @jsenv/* to src/ instead of dist/ so "go to definition" opens the sources
    "customConditions": ["dev:jsenv"],
    "paths": {
      "@jsenv/core": [
        "./main.js"
      ],
      "@jsenv/core/*": [
        "./*"
      ],
    }
  },
  // keep the TS/JS language service project small: generated + vendored files
  // would otherwise push it past the "project-wide features disabled" threshold
  "exclude": [
    "**/node_modules",
    "**/.jsenv",
    "**/snapshots"
  ]
}